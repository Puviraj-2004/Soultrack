# Server
PORT=3000
NODE_ENV=production
# Set PUBLIC_BASE_URL to your Render URL (e.g. https://soultrack-server.onrender.com)
PUBLIC_BASE_URL=http://localhost:3000

# Database: works with Neon DB or Supabase Postgres connection string
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/soultrack?sslmode=require
AUTO_MIGRATE=true

# Admin authentication (choose a strong password/passphrase)
ADMIN_SECRET=change-me-to-a-long-random-secret
TOKEN_SECRET=change-me-to-another-long-random-secret

# Storage: "r2" for Cloudflare R2 (recommended), or "local" for local disk dev testing
STORAGE_MODE=r2
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=soultrack-audio
R2_PUBLIC_URL=https://pub-your-bucket.r2.dev

# Optional: Default Android APK release metadata (can also be managed in Admin Panel)
APP_LATEST_VERSION_CODE=1
APP_LATEST_VERSION_NAME=1.0.0
APP_DOWNLOAD_URL=https://github.com/Puviraj-2004/Soultrack/releases/latest
APP_RELEASE_NOTES=Initial Soultrack Android release
APP_FORCE_UPDATE=false

# Optional: Improve YouTube extraction on cloud hosts like Render
# YTDLP_COOKIES_B64=<base64-encoded-youtube-cookies.txt>
# YTDLP_PROXY=

# Optional: AI metadata extraction (genre, mood, artist cleanup) via Google Gemini API
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-3.5-flash-lite
